#!/bin/sh
# qits-token <audience> — print a bearer for one platform audience.
#
# Ask for qits-platform: present the result as a bearer to the public edge and it reaches every
# service behind it —
#
#   curl -H "Authorization: Bearer $(qits-token qits-platform)" https://projects.qits.$QITS_DOMAIN/projects/api/…
#
# A RUNNER workspace container carries QITS_TOKEN, its own opaque qits_tok_ token that
# qits-workspaces mints and injects; a DIRECT container (admin, editor, today's regular rows)
# carries the commissioned pair instead. With QITS_TOKEN set this prints it outright and ignores
# the audience argument — there is nothing to mint, since QITS_TOKEN already works as a bearer:
# present it and the edge introspects it, forwarding a short qits-platform JWT to the service
# behind. Otherwise it mints fresh from the commissioned client, one call per audience named.
# Tokens are short-lived by the idp's TTL; mint/read at the call site rather than caching.
#
# Loud when it cannot work, unlike the git helper: that one must stay silent so git falls through
# to its next helper, this one is called by a person or an agent who needs to know why.
set -eu
audience=${1:-}
if [ -z "$audience" ]; then
  echo "usage: qits-token <audience>   (a platform audience, e.g. ${QITS_WORKSPACE_DAEMON_AUTH_AUDIENCE:-qits-platform})" >&2
  exit 2
fi
if [ -n "${QITS_TOKEN:-}" ]; then
  printf %s "$QITS_TOKEN"
  exit 0
fi
if [ -z "${QITS_COMMISSIONED_CLIENT_ID:-}" ] || [ -z "${QITS_COMMISSIONED_CLIENT_SECRET:-}" ]; then
  echo "qits-token: this container carries no commissioned client (QITS_COMMISSIONED_CLIENT_ID/_SECRET unset)" >&2
  exit 1
fi
if [ -z "${QITS_GIT_AUTH_TOKEN_URL:-}" ]; then
  echo "qits-token: no token endpoint (QITS_GIT_AUTH_TOKEN_URL unset)" >&2
  exit 1
fi
response=$(curl -fsS --connect-timeout 2 --max-time 10 \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "client_id=$QITS_COMMISSIONED_CLIENT_ID" \
  --data-urlencode "client_secret=$QITS_COMMISSIONED_CLIENT_SECRET" \
  --data-urlencode "grant_type=client_credentials" \
  --data-urlencode "audience=$audience" \
  "$QITS_GIT_AUTH_TOKEN_URL") || { echo "qits-token: the idp refused the commissioned client for audience $audience" >&2; exit 1; }
printf '%s' "$response" | jq -er '.access_token // empty' \
  || { echo "qits-token: the idp answered without an access_token" >&2; exit 1; }
