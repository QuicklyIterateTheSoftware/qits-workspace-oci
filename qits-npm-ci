#!/bin/sh
# qits-npm-ci [npm ci arguments] — `npm ci` against the platform's registries, lockfile restored.
#
# THE LOCKFILE IS WHY THIS EXISTS. npm pins a full `resolved` URL per package and fetches tarballs by
# that URL, never through the configured registry — so a package-lock.json generated on a developer
# host names that host's addresses (mirror.dev.localhost:8080, localhost:8082, …), none of which
# exist on the platform network, and `npm ci` in a workspace dies on every tarball. npm's own knob
# (`--replace-registry-host=always`) cannot do it against registries mounted under a path — measured
# in the ci recipes, which carry this same swap and are where the pattern is maintained.
#
# So: the origins are swapped and the paths kept (the integrity hashes are what make that safe —
# bytes from another address must still hash the same), `npm ci` runs, and the lockfile is put back
# BYTE FOR BYTE, timestamps included, on every exit path. Nothing of the swap survives into the
# checkout; an agent's `git status` stays clean and a commit cannot carry a platform address.
#
# `npm ci` only — it never writes the lockfile, which is what makes a blind restore correct. For
# `npm install <new dependency>` the edit is the point, and it has to be made against a registry
# the lockfile can record; do that on a developer host.
#
# Two registries since the byte plane split: the npmjs mirror (npm_config_registry, every ordinary
# entry) and the @qits scope (QITS_WORKSPACE_NPM_REGISTRY_URL, told apart by its path). The order of
# the two expressions is the whole trick — broad swap first, path-anchored correction second.
# INERT UNTIL TOLD, like the shim: with either address unset this is a plain `npm ci`.
set -eu
lock=package-lock.json
if [ ! -f "$lock" ]; then
  echo "qits-npm-ci: no $lock in $(pwd)" >&2
  exit 2
fi
proxy=${npm_config_registry:-}
hosted=${QITS_WORKSPACE_NPM_REGISTRY_URL:-}
if [ -z "$proxy" ] || [ -z "$hosted" ]; then
  exec npm ci "$@" # the shim, and its mirror credential, apply here too
fi
origin_of() { printf '%s' "$1" | sed -E 's#^(https?://[^/]+).*#\1#'; }
path_of() { printf '%s' "$1" | sed -E 's#^https?://[^/]+##'; }
proxy_origin=$(origin_of "$proxy")
hosted_origin=$(origin_of "$hosted")
hosted_path=$(path_of "$hosted")
backup=$(mktemp "${TMPDIR:-/tmp}/qits-npm-ci.XXXXXX")
cp -p "$lock" "$backup"
restore() { cp -p "$backup" "$lock"; rm -f "$backup"; }
trap restore EXIT INT TERM HUP
sed -i -E \
  -e "s#(\"resolved\": \")https?://[^/\"]+#\\1$proxy_origin#" \
  -e "s#(\"resolved\": \")https?://[^/\"]+($hosted_path)#\\1$hosted_origin\\2#" \
  "$lock"
# `npm` resolves to the shim ahead of the real binary, which is what carries the @qits scope and
# the edge mirror's `_auth` — the swapped tarball URLs sit under the registry's path, so they get it.
npm ci "$@"
