#!/bin/sh

[ "$1" = get ] || exit 0
host=
protocol=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host=${line#host=} ;;
    protocol=*) protocol=${line#protocol=} ;;
  esac
done
[ "$host" = "$QITS_GIT_AUTH_HOST" ] || exit 0
case "$protocol" in
  http|https) ;;
  *) exit 0 ;;
esac
# QITS_TOKEN — a container's own opaque token, minted and injected by qits-workspaces — is carried
# by a runner-placed workspace container, and by an admin or editor workspace (DIRECT-placed on
# qits-containers) as well: answer with it directly and never call out. Without it there is no
# credential to give, so stay silent and let git fall through to its next helper.
[ -n "$QITS_TOKEN" ] || exit 0
printf 'username=oauth2\npassword=%s\n\n' "$QITS_TOKEN"
