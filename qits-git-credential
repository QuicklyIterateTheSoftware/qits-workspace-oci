#!/bin/sh

[ "$1" = get ] || exit 0
host=
protocol=
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    host=*) host=${line#host=} ;;
    protocol=*) protocol=${line#protocol=} ;;
  esac
done
[ "$host" = "$QITS_GIT_AUTH_HOST" ] || exit 0
case "$protocol" in
  http|https) ;;
  *) exit 0 ;;
esac
# QITS_TOKEN — a container's own opaque token, minted and injected by qits-workspaces, not a
# commissioned pair to mint with — is carried by a runner-placed workspace container, and by an
# admin or editor workspace (DIRECT-placed on qits-containers) as well: answer with it directly
# and never call out. A container still holding a commissioned pair instead falls through to the
# branch below; that branch remains until every container carries QITS_TOKEN (its removal is
# qits-876).
if [ -n "$QITS_TOKEN" ]; then
  printf 'username=oauth2\npassword=%s\n\n' "$QITS_TOKEN"
  exit 0
fi
[ -n "$QITS_COMMISSIONED_CLIENT_ID" ] && [ -n "$QITS_COMMISSIONED_CLIENT_SECRET" ] || exit 0
response=$(curl -fsS --connect-timeout 2 --max-time 10 \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "client_id=$QITS_COMMISSIONED_CLIENT_ID" \
  --data-urlencode "client_secret=$QITS_COMMISSIONED_CLIENT_SECRET" \
  --data-urlencode "grant_type=client_credentials" \
  --data-urlencode "audience=$QITS_GIT_AUTH_AUDIENCE" \
  "$QITS_GIT_AUTH_TOKEN_URL") || exit 0
token=$(printf '%s' "$response" | jq -r '.access_token // empty')
[ -n "$token" ] || exit 0
printf 'username=oauth2\npassword=%s\n\n' "$token"
