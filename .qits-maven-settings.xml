<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- THE URL IS THE `-D` PROPERTY, NOT `${env.QITS_MAVEN_REPOSITORY_URL}`. qits-ci's recipes no
         longer inject any URL variable (qits-731): both recipes derive the host from QITS_DOMAIN and
         pass it with `-Dqits.maven.repository.url`, which is also the pom's own default — so the
         mirror reads the same one value the rest of this repository does, on the platform and off
         it. qits-workspace-editor-oci carries the env spelling, which is fine there: that reactor
         resolves junit and nothing else, so its mirror is never consulted for a platform artifact.
         THIS one exists to resolve `eu.wohlben.qits:qits-platform-access-cli-binary` through the
         mirror, so the URL is load-bearing on every build. Exact repository-id matches win over
         Maven's external:http:* blocker without permitting arbitrary HTTP repositories. -->
    <mirror>
      <id>qits-maven-network</id>
      <mirrorOf>qits-maven</mirrorOf>
      <url>${qits.maven.repository.url}</url>
    </mirror>
    <!-- Maven Central through qits-mirror's cache, https://mirror.qits.$QITS_DOMAIN/mirror/maven/central,
         derived by both recipes. The exact repository id is the same blocker exemption the entry
         above uses, scoped to the one repository the profile below declares — so while
         QITS_MAVEN_CENTRAL_URL is unset or empty, nothing declares qits-central, this entry matches
         nothing, and the unexpanded URL is never dialled. -->
    <mirror>
      <id>qits-central-proxy</id>
      <mirrorOf>qits-central</mirrorOf>
      <url>${env.QITS_MAVEN_CENTRAL_URL}</url>
    </mirror>
  </mirrors>
  <servers>
    <!-- BuildKit supplies the commissioned CI client only for the Maven build instruction. -->
    <server>
      <id>qits-maven-network</id>
      <username>${env.QITS_MAVEN_AUTH_USR}</username>
      <password>${env.QITS_MAVEN_AUTH_PSW}</password>
    </server>
    <!-- Same commissioned credential, for the Central cache: both hosts answer 401 anonymously, so
         every build that resolves through them needs it. Both variables are the BuildKit secret
         mounts on docker/Dockerfile's mvnw RUN, as for qits-maven-network. -->
    <server>
      <id>qits-central-proxy</id>
      <username>${env.QITS_MAVEN_AUTH_USR}</username>
      <password>${env.QITS_MAVEN_AUTH_PSW}</password>
    </server>
  </servers>
  <profiles>
    <!-- Active only while QITS_MAVEN_CENTRAL_URL is NON-EMPTY — measured on Maven 3.9: an empty
         environment value does not activate a property-presence profile. Both recipes always set
         it, so the platform build always resolves Central through the cache; unset or empty is the
         off switch for a build outside the platform, and means stock Maven Central. Central itself
         is re-declared DISABLED, because repository ordering consults the stock central first and
         the mirror above would never see a request; qits-central takes its place and the mirror
         reroutes it whole to the cache. -->
    <profile>
      <id>qits-central-proxy</id>
      <activation>
        <property><name>env.QITS_MAVEN_CENTRAL_URL</name></property>
      </activation>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>qits-central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>false</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>qits-central</id>
          <url>https://repo1.maven.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
</settings>
